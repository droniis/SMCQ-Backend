# ============================================================
# SMCQ — variáveis de ambiente
# Copie este arquivo para .env e preencha. O .env NÃO vai para o git.
# ============================================================

# Segredo de assinatura dos tokens JWT (obrigatório fora dos testes).
# Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Onde os dados ficam: postgres (banco real) ou memoria (some ao reiniciar)
PERSISTENCIA=postgres

# Conexão com o PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smcq
DB_USER=postgres
DB_PASSWORD=

# (Opcional) Pasta bin do PostgreSQL, usada pelo npm run db:backup e pelo db:exemplo se o pg_dump/psql não forem achados no PATH
# PG_BIN=C:\Program Files\PostgreSQL\18\bin

# (Opcional) Quantos backups do npm run db:backup manter na pasta backups/ (padrão: 30)
# BACKUP_RETENCAO=30
