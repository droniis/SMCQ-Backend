{
  "name": "smcq-backend",
  "version": "1.0.0",
  "description": "Backend do SMCQ",
  "main": "server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "lint": "eslint .",
    "test:coverage": "jest --coverage",
    "db:init": "node db/init.js",
    "db:seed": "node db/seed.js",
    "db:backup": "node db/backup.js",
    "db:exemplo": "node db/gerar-exemplo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "setupFiles": [
      "./tests/helpers/ambienteTeste.js",
      "./tests/helpers/semInternet.js"
    ],
    "collectCoverageFrom": [
      "server.js",
      "services/**/*.js",
      "repositorios/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ]
  }
}
